# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# uv / venv
.venv/
venv/

# DB (local dev DB lives under data/; production DB excluded)
*.db
*.db-shm
*.db-wal
observatory.sqlite*
data/*
!data/.gitkeep

# Live agent session raw logs (stored as flat files, not versioned)
live-sessions/*.log
live-sessions/*.jsonl
!live-sessions/.gitkeep

# Generated Markdown exports (derived from DB, not source of truth)
generated-docs/

# Local dev server logs
.logs/

# Media uploads (binary, not tracked by default; lecturers add per machine)
media/**
!media/.gitkeep

# IDE / harness local state
.vscode/
.idea/
.claude/
.cursor/

# OS
.DS_Store
Thumbs.db

# Build / dist
dist/
build/
*.egg

# Node / visual QA
node_modules/
test-results/
playwright-report/
